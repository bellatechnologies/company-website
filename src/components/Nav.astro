---
import Icon from './Icon.astro';
---
<header class="fixed top-3 left-0 right-0 z-50 px-3 sm:px-4">
  <nav class="max-w-content mx-auto bg-cream/90 backdrop-blur-sm rounded-2xl shadow-floating border border-charcoal/5 overflow-hidden">
    <div class="bg-gold text-[#412402] text-center text-xs sm:text-sm font-semibold py-1.5 px-4">
      Limited time: Your $197 Booking Audit is FREE
    </div>
    <div class="flex items-center justify-between px-5 sm:px-7 py-3">
      <a href="#" class="font-jakarta text-lg sm:text-xl font-bold" style="letter-spacing: -0.1px;">Bella Technologies</a>

      <div class="hidden nav:flex items-center gap-8 text-lg font-medium">
        <a href="#how-it-works" class="nav-link hover:text-olive transition-colors">How It Works</a>
        <a href="#faq" class="nav-link hover:text-olive transition-colors">FAQ</a>
        <a href="/contact" class="nav-link hover:text-olive transition-colors">Contact</a>
        <div class="group relative">
          <a href="#book-a-demo" class="flex items-center gap-2.5 bg-olive text-cream pl-5 pr-1.5 py-1.5 rounded-full font-semibold hover:bg-charcoal transition-colors">
            <span>Get My <span class="line-through opacity-60">$197</span> FREE Booking Audit</span>
            <span class="w-7 h-7 rounded-full bg-cream flex items-center justify-center shrink-0">
              <Icon name="move-up-right" class="w-3.5 h-3.5 text-olive" />
            </span>
          </a>
          <span class="absolute -top-1 -right-1 z-10 flex h-3.5 w-3.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-gold border-2 border-cream"></span>
          </span>
        </div>
      </div>

      <button id="menu-toggle" class="nav:hidden p-2 -mr-2" aria-label="Toggle menu" aria-expanded="false">
        <Icon name="menu" class="w-6 h-6" />
      </button>
    </div>

    <div id="mobile-menu" class="hidden nav:hidden flex-col gap-1 px-5 pb-4 pt-1">
      <a href="#how-it-works" class="nav-link block py-2.5 text-lg font-medium hover:text-olive transition-colors">How It Works</a>
      <a href="#faq" class="nav-link block py-2.5 text-lg font-medium hover:text-olive transition-colors">FAQ</a>
      <a href="/contact" class="nav-link block py-2.5 text-lg font-medium hover:text-olive transition-colors">Contact</a>
      <div class="flex justify-center mt-2">
        <div class="group relative inline-flex">
          <a href="#book-a-demo" class="inline-flex items-center gap-2.5 bg-olive text-cream pl-5 pr-1.5 py-1.5 rounded-full font-semibold hover:bg-charcoal transition-colors">
            <span>Get My <span class="line-through opacity-60">$197</span> FREE Booking Audit</span>
            <span class="w-7 h-7 rounded-full bg-cream flex items-center justify-center shrink-0">
              <Icon name="move-up-right" class="w-3.5 h-3.5 text-olive" />
            </span>
          </a>
          <span class="absolute -top-1 -right-1 z-10 flex h-3.5 w-3.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-gold border-2 border-cream"></span>
          </span>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  menuToggle.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    mobileMenu.classList.toggle('flex');
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    if (!isOpen) return;
    if (mobileMenu.contains(e.target as Node) || menuToggle.contains(e.target as Node)) return;
    mobileMenu.classList.add('hidden');
    mobileMenu.classList.remove('flex');
    menuToggle.setAttribute('aria-expanded', 'false');
  });

  // Active nav state: URL-based for real pages (e.g. /contact), scroll-spy
  // for in-page anchor sections (How It Works / FAQ) on the homepage.
  const navLinks = document.querySelectorAll('.nav-link');
  const path = window.location.pathname.replace(/\/$/, '') || '/';

  const setActive = (predicate: (href: string | null) => boolean) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      link.classList.toggle('active', predicate(href));
    });
  };

  if (path !== '/' && path !== '') {
    setActive((href) => href === path);
  } else {
    const sections = ['how-it-works', 'faq']
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.find((entry) => entry.isIntersecting);
          if (visible) setActive((href) => href === `#${visible.target.id}`);
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>
