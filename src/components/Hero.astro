---
import Icon from './Icon.astro';
---
<section class="bg-sage/10 pt-36 pb-16 sm:pt-44 sm:pb-24">
  <div class="max-w-content mx-auto px-4 sm:px-6 text-center">
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight !leading-tight max-w-3xl mx-auto">
      Turn More Enquiries Into Bookings and Keep Clients Coming Back.
    </h1>
    <p class="mt-6 text-base sm:text-lg text-charcoal/75 max-w-2xl mx-auto leading-relaxed">
      Built for spa and wellness owners who are missing bookings to slow replies and no re-booking system. Start with a <span class="line-through opacity-60">$197</span> FREE audit — we'll show you exactly where you're losing enquiries, plus the highest-impact fixes to win them back.
    </p>

    <div class="mt-10 flex items-center justify-center gap-2 sm:gap-3">
      <div class="flex flex-col items-center gap-2">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-sage/15 flex items-center justify-center">
          <Icon name="message-circle" class="w-5 h-5 sm:w-6 sm:h-6 text-olive" />
        </div>
        <span class="text-xs sm:text-sm text-charcoal/70">Enquiry</span>
      </div>
      <svg class="w-8 sm:w-12 h-4 shrink-0 -mt-5" viewBox="0 0 60 20" fill="none" aria-hidden="true">
        <path d="M2 10 H50" stroke="#C9A24B" stroke-width="2" stroke-dasharray="4 4"/>
        <path d="M44 4 L54 10 L44 16" stroke="#C9A24B" stroke-width="2" fill="none"/>
      </svg>
      <div class="flex flex-col items-center gap-2">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-sage/15 flex items-center justify-center">
          <Icon name="message-square-more" class="w-5 h-5 sm:w-6 sm:h-6 text-olive" />
        </div>
        <span class="text-xs sm:text-sm text-charcoal/70">Instant reply</span>
      </div>
      <svg class="w-8 sm:w-12 h-4 shrink-0 -mt-5" viewBox="0 0 60 20" fill="none" aria-hidden="true">
        <path d="M2 10 H50" stroke="#C9A24B" stroke-width="2" stroke-dasharray="4 4"/>
        <path d="M44 4 L54 10 L44 16" stroke="#C9A24B" stroke-width="2" fill="none"/>
      </svg>
      <div class="flex flex-col items-center gap-2">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-olive flex items-center justify-center">
          <Icon name="calendar-check" class="w-5 h-5 sm:w-6 sm:h-6 text-cream" />
        </div>
        <span class="text-xs sm:text-sm text-charcoal/70">Booked</span>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-center">
      <a href="#book-a-demo" class="w-auto flex items-center justify-center gap-2.5 sm:gap-3 bg-olive text-cream pl-5 sm:pl-8 pr-1.5 sm:pr-2 py-1.5 sm:py-2 rounded-full text-base sm:text-lg font-semibold shadow-card hover:bg-charcoal hover:shadow-card-hover transition-all">
        <span>Get My <span class="line-through opacity-60">$197</span> FREE Booking Audit</span>
        <span class="w-7 h-7 sm:w-11 sm:h-11 rounded-full bg-cream flex items-center justify-center shrink-0">
          <Icon name="move-up-right" class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-olive" />
        </span>
      </a>
    </div>
  </div>
</section>
