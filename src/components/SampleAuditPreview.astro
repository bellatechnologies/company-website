---
import Icon from './Icon.astro';
---
<section class="py-16 sm:py-24">
  <div class="max-w-content mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight">This Is What Your Audit Looks Like</h2>
      <p class="mt-5 text-base sm:text-lg text-charcoal/75 leading-relaxed">Plain-English findings, ranked by impact, not a wall of jargon. Here's a redacted page from a real audit.</p>
    </div>

    <div class="mt-12 max-w-md mx-auto bg-white rounded-2xl shadow-floating overflow-hidden">
      <div class="flex gap-1.5 px-4 py-2.5 border-b border-charcoal/10">
        <span class="w-2 h-2 rounded-full bg-charcoal/15"></span>
        <span class="w-2 h-2 rounded-full bg-charcoal/15"></span>
        <span class="w-2 h-2 rounded-full bg-charcoal/15"></span>
      </div>
      <div class="p-5 sm:p-6">
        <div class="text-[11px] uppercase tracking-wide text-sage font-semibold">Booking Funnel Audit</div>
        <div class="h-3.5 w-1/2 bg-charcoal/10 rounded mt-2 mb-4"></div>

        <div class="flex flex-col gap-2.5">
          <div class="flex items-start gap-3 p-3 rounded-lg bg-red-50">
            <span class="shrink-0 text-[10px] font-semibold text-red-800 bg-red-300 px-2 py-0.5 rounded-full">Critical</span>
            <div>
              <p class="text-sm font-medium text-charcoal">No after-hours reply on WhatsApp</p>
              <p class="text-xs text-charcoal/60 mt-0.5">Enquiries sent after 6pm got a response the next afternoon.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-lg bg-amber-50">
            <span class="shrink-0 text-[10px] font-semibold text-amber-800 bg-amber-300 px-2 py-0.5 rounded-full">High</span>
            <div>
              <p class="text-sm font-medium text-charcoal">Booking form requires account creation</p>
              <p class="text-xs text-charcoal/60 mt-0.5">Mystery shopper abandoned at step 3 of 5.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-lg bg-green-50 blur-[3px] opacity-60 select-none">
            <span class="shrink-0 text-[10px] font-semibold text-green-800 bg-green-300 px-2 py-0.5 rounded-full">Medium</span>
            <div>
              <p class="text-sm font-medium text-charcoal">No rebooking reminder for repeat services</p>
              <p class="text-xs text-charcoal/60 mt-0.5">Full detail revealed in your report.</p>
            </div>
          </div>
        </div>

        <div class="mt-4 h-2.5 w-2/5 bg-charcoal/10 rounded"></div>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a href="#book-a-demo" class="flex items-center justify-center gap-2.5 sm:gap-3 bg-olive text-cream pl-5 sm:pl-8 pr-1.5 sm:pr-2 py-1.5 sm:py-2 rounded-full text-base sm:text-lg font-semibold shadow-card hover:bg-charcoal hover:shadow-card-hover transition-all">
        <span>Get My <span class="line-through opacity-60">$197</span> FREE Booking Audit</span>
        <span class="w-7 h-7 sm:w-11 sm:h-11 rounded-full bg-cream flex items-center justify-center shrink-0">
          <Icon name="move-up-right" class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-olive" />
        </span>
      </a>
    </div>
  </div>
</section>
