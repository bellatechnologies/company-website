---
import Icon from './Icon.astro';
---
<section class="bg-olive py-16 sm:py-24">
  <div class="max-w-content mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight text-cream max-w-2xl mx-auto">
      Every Enquiry You Miss Costs You $1,000+ Over 6 Months.
    </h2>
    <p class="mt-5 text-base sm:text-lg text-cream/85 max-w-xl mx-auto leading-relaxed">
      Ready to stop losing it? Get your free audit and see exactly where enquiries are falling through, plus the highest-impact fixes to win them back.
    </p>
    <a href="#book-a-demo" class="mt-8 inline-flex items-center gap-3 bg-gold text-charcoal pl-8 pr-2 py-2 rounded-full text-lg font-semibold shadow-card hover:shadow-card-hover hover:brightness-105 transition-all">
      <span>Get My <span class="line-through opacity-60">$197</span> FREE Booking Audit</span>
      <span class="w-11 h-11 rounded-full bg-cream flex items-center justify-center shrink-0">
        <Icon name="arrow-up-right" class="w-5 h-5 text-charcoal" />
      </span>
    </a>
  </div>
</section>
