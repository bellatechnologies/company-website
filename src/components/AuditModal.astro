---
import Icon from './Icon.astro';
---
<div id="audit-modal" class="hidden fixed inset-0 z-[100] p-4">
  <div id="audit-modal-backdrop" class="absolute inset-0 bg-charcoal/60"></div>

  <div class="relative bg-cream rounded-2xl shadow-floating w-full max-w-md mx-auto my-6 sm:my-10 p-6 sm:p-8 max-h-[90vh] overflow-y-auto">
    <button type="button" id="audit-modal-close" aria-label="Close" class="absolute top-4 right-4 text-charcoal/40 hover:text-charcoal transition-colors">
      <Icon name="x" class="w-5 h-5" />
    </button>

    <!-- Macro step indicator -->
    <div class="flex items-center justify-center gap-2 mb-7 select-none">
      <div class="flex items-center gap-1.5" data-step-node="1">
        <span class="step-circle w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-olive text-cream transition-colors">1</span>
        <span class="step-label text-xs font-semibold text-olive transition-colors">Qualify</span>
      </div>
      <div class="w-6 sm:w-8 h-px bg-charcoal/15"></div>
      <div class="flex items-center gap-1.5" data-step-node="2">
        <span class="step-circle w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-charcoal/10 text-charcoal/40 transition-colors">2</span>
        <span class="step-label text-xs font-semibold text-charcoal/40 transition-colors">Details</span>
      </div>
      <div class="w-6 sm:w-8 h-px bg-charcoal/15"></div>
      <div class="flex items-center gap-1.5" data-step-node="3">
        <span class="step-circle w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold bg-charcoal/10 text-charcoal/40 transition-colors">3</span>
        <span class="step-label text-xs font-semibold text-charcoal/40 transition-colors">Auditing</span>
      </div>
    </div>

    <!-- Quiz -->
    <div id="modal-quiz-section">
      <div id="quiz-progress" class="flex items-center gap-1.5 mb-6">
        <div class="quiz-seg flex-1 h-1 rounded-full bg-charcoal/10 transition-colors"></div>
        <div class="quiz-seg flex-1 h-1 rounded-full bg-charcoal/10 transition-colors"></div>
        <div class="quiz-seg flex-1 h-1 rounded-full bg-charcoal/10 transition-colors"></div>
        <div class="quiz-seg flex-1 h-1 rounded-full bg-charcoal/10 transition-colors"></div>
      </div>

      <div class="quiz-question" data-q="0" data-key="bookings">
        <p class="text-xs font-semibold text-olive mb-1">Question 1 of 4</p>
        <h3 class="text-lg sm:text-xl font-bold text-charcoal mb-5 leading-snug">How many bookings does your business get in a typical month?</h3>
        <div class="flex flex-col gap-2.5">
          <button type="button" class="quiz-option" data-value="under-20">Under 20</button>
          <button type="button" class="quiz-option" data-value="20-50">20–50</button>
          <button type="button" class="quiz-option" data-value="50-100">50–100</button>
          <button type="button" class="quiz-option" data-value="100-plus">100+</button>
        </div>
      </div>

      <div class="quiz-question hidden" data-q="1" data-key="channel">
        <p class="text-xs font-semibold text-olive mb-1">Question 2 of 4</p>
        <h3 class="text-lg sm:text-xl font-bold text-charcoal mb-5 leading-snug">How do most enquiries reach you right now?</h3>
        <div class="flex flex-col gap-2.5">
          <button type="button" class="quiz-option" data-value="calls">Phone calls</button>
          <button type="button" class="quiz-option" data-value="dms">WhatsApp or Instagram DMs</button>
          <button type="button" class="quiz-option" data-value="form">Website form</button>
          <button type="button" class="quiz-option" data-value="walk-in">Walk-ins</button>
        </div>
      </div>

      <div class="quiz-question hidden" data-q="2" data-key="decisionMaker">
        <p class="text-xs font-semibold text-olive mb-1">Question 3 of 4</p>
        <h3 class="text-lg sm:text-xl font-bold text-charcoal mb-5 leading-snug">Are you the one who'd decide on fixing this?</h3>
        <div class="flex flex-col gap-2.5">
          <button type="button" class="quiz-option" data-value="yes">Yes, that's me</button>
          <button type="button" class="quiz-option" data-value="no">No, someone else</button>
        </div>
      </div>

      <div class="quiz-question hidden" data-q="3" data-key="painPoint">
        <p class="text-xs font-semibold text-olive mb-1">Question 4 of 4</p>
        <h3 class="text-lg sm:text-xl font-bold text-charcoal mb-5 leading-snug">What's hurting more right now?</h3>
        <div class="flex flex-col gap-2.5">
          <button type="button" class="quiz-option" data-value="missed-enquiries">Missed enquiries</button>
          <button type="button" class="quiz-option" data-value="no-rebooking">No re-booking</button>
          <button type="button" class="quiz-option" data-value="both">Both</button>
        </div>
      </div>
    </div>

    <!-- Contact details -->
    <div id="modal-details-section" class="hidden">
      <h3 class="text-xl sm:text-2xl font-bold text-charcoal mb-1">Where should we send your audit?</h3>
      <p class="text-sm text-charcoal/60 mb-5">Takes 20 seconds. We'll send your free audit to this email within 48 hours.</p>
      <form id="audit-lead-form" class="flex flex-col gap-3">
        <input type="text" required placeholder="Full name" name="name" class="modal-input" />
        <input type="email" required placeholder="Email address" name="email" class="modal-input" />
        <input type="tel" required placeholder="WhatsApp number" name="phone" class="modal-input" />
        <button type="submit" class="mt-2 w-full flex items-center justify-center gap-2 bg-olive text-cream font-semibold rounded-xl py-3.5 hover:bg-charcoal transition-colors">
          <span>Get My Free Booking Audit</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </button>
      </form>
      <div class="mt-4 flex items-center justify-center gap-4 text-xs text-charcoal/60">
        <span class="flex items-center gap-1"><Icon name="check-circle" class="w-3.5 h-3.5 text-olive" />48-hour turnaround</span>
        <span class="flex items-center gap-1"><Icon name="check-circle" class="w-3.5 h-3.5 text-olive" />No obligation</span>
      </div>
    </div>

    <!-- Confirmation -->
    <div id="modal-done-section" class="hidden text-center py-4">
      <div class="w-14 h-14 rounded-full bg-olive/10 flex items-center justify-center mx-auto mb-4">
        <Icon name="check" class="w-7 h-7 text-olive" />
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-charcoal mb-2">You're all set</h3>
      <p class="text-sm sm:text-base text-charcoal/70 max-w-xs mx-auto">We'll send your booking funnel audit report to your email within 48 hours.</p>
      <button type="button" id="modal-close-done" class="mt-6 inline-flex items-center gap-2 text-olive font-semibold hover:text-charcoal transition-colors">Close</button>
    </div>
  </div>
</div>

<script>
  const auditModal = document.getElementById('audit-modal')!;
  const auditModalBackdrop = document.getElementById('audit-modal-backdrop')!;
  const auditModalClose = document.getElementById('audit-modal-close')!;
  const modalCloseDone = document.getElementById('modal-close-done');
  const quizSection = document.getElementById('modal-quiz-section')!;
  const detailsSection = document.getElementById('modal-details-section')!;
  const doneSection = document.getElementById('modal-done-section')!;
  const quizQuestions = Array.from(document.querySelectorAll('.quiz-question')) as HTMLElement[];
  const quizSegs = Array.from(document.querySelectorAll('#quiz-progress .quiz-seg'));
  const auditLeadForm = document.getElementById('audit-lead-form') as HTMLFormElement | null;
  const stepOrder = ['quiz', 'details', 'done'];
  const answers: Record<string, string> = {};

  const setMacroStep = (step: string) => {
    stepOrder.forEach((s, idx) => {
      const node = document.querySelector(`[data-step-node="${idx + 1}"]`)!;
      const circle = node.querySelector('.step-circle')!;
      const label = node.querySelector('.step-label')!;
      const reached = stepOrder.indexOf(s) <= stepOrder.indexOf(step);
      circle.classList.toggle('bg-olive', reached);
      circle.classList.toggle('text-cream', reached);
      circle.classList.toggle('bg-charcoal/10', !reached);
      circle.classList.toggle('text-charcoal/40', !reached);
      label.classList.toggle('text-olive', s === step);
      label.classList.toggle('text-charcoal/40', s !== step);
    });
  };

  const updateQuizProgress = (answeredCount: number) => {
    quizSegs.forEach((seg, i) => seg.classList.toggle('bg-olive', i < answeredCount));
  };

  const resetModal = () => {
    Object.keys(answers).forEach((k) => delete answers[k]);
    quizQuestions.forEach((q, i) => q.classList.toggle('hidden', i !== 0));
    document.querySelectorAll('.quiz-option.selected').forEach((btn) => btn.classList.remove('selected'));
    updateQuizProgress(0);
    quizSection.classList.remove('hidden');
    detailsSection.classList.add('hidden');
    doneSection.classList.add('hidden');
    setMacroStep('quiz');
    if (auditLeadForm) auditLeadForm.reset();
  };

  const openAuditModal = () => {
    resetModal();
    auditModal.classList.remove('hidden');
    auditModal.classList.add('open');
    document.body.classList.add('overflow-hidden');
  };

  const closeAuditModal = () => {
    auditModal.classList.add('hidden');
    auditModal.classList.remove('open');
    document.body.classList.remove('overflow-hidden');
  };

  document.querySelectorAll('a[href="#book-a-demo"]').forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      openAuditModal();
    });
  });

  auditModalBackdrop.addEventListener('click', closeAuditModal);
  auditModalClose.addEventListener('click', closeAuditModal);
  if (modalCloseDone) modalCloseDone.addEventListener('click', closeAuditModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !auditModal.classList.contains('hidden')) closeAuditModal();
  });

  quizQuestions.forEach((questionEl) => {
    const qIndex = Number(questionEl.dataset.q);
    const key = questionEl.dataset.key!;
    questionEl.querySelectorAll('.quiz-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        answers[key] = (btn as HTMLElement).dataset.value!;
        questionEl.querySelectorAll('.quiz-option').forEach((b) => b.classList.remove('selected'));
        btn.classList.add('selected');
        updateQuizProgress(qIndex + 1);

        setTimeout(() => {
          if (qIndex < quizQuestions.length - 1) {
            questionEl.classList.add('hidden');
            quizQuestions[qIndex + 1].classList.remove('hidden');
          } else {
            quizSection.classList.add('hidden');
            detailsSection.classList.remove('hidden');
            setMacroStep('details');
          }
        }, 350);
      });
    });
  });

  if (auditLeadForm) {
    auditLeadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(auditLeadForm);
      answers.name = formData.get('name') as string;
      answers.email = formData.get('email') as string;
      answers.phone = formData.get('phone') as string;
      // TODO: wire this to a real lead destination (CRM webhook, Sheet, etc.)
      detailsSection.classList.add('hidden');
      doneSection.classList.remove('hidden');
      setMacroStep('done');
    });
  }
</script>
