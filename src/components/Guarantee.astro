---
import Icon from './Icon.astro';
---
<section class="py-16 sm:py-24 bg-sage/10">
  <div class="max-w-content mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <div class="w-14 h-14 rounded-full bg-gold/15 flex items-center justify-center mx-auto mb-5">
        <Icon name="shield-check" class="w-7 h-7 text-gold" />
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight">Our Guarantee</h2>
      <p class="mt-5 text-base sm:text-lg text-charcoal/75 leading-relaxed">
        If we don't fix the top leak your audit uncovered within 30 days, that month is on us. We don't ask you to bet on a promise, we take the risk instead.
      </p>
    </div>
  </div>
</section>
