---
import Icon from './Icon.astro';
---
<footer class="bg-cream border-t border-charcoal/10 pt-16 sm:pt-24 pb-28 sm:pb-14">
  <div class="max-w-content mx-auto px-4 sm:px-6">
    <div class="grid sm:grid-cols-[1.4fr_1fr_1fr] gap-8 sm:gap-6">
      <div>
        <div class="h-1 w-12 rounded-full bg-olive mb-3.5"></div>
        <p class="font-jakarta text-xl font-bold">Bella Technologies</p>
        <p class="mt-3 text-charcoal/60 text-lg leading-relaxed max-w-xs">Helping spa and wellness businesses in Florida, USA turn more enquiries into bookings and keep clients coming back.</p>
      </div>

      <div>
        <div class="h-1 w-12 rounded-full bg-gold mb-3.5"></div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage mb-2">Menu</p>
        <nav class="flex flex-col gap-2">
          <a href="#" class="text-lg hover:text-olive transition-colors">Home</a>
          <a href="#how-it-works" class="text-lg hover:text-olive transition-colors">How It Works</a>
          <a href="#faq" class="text-lg hover:text-olive transition-colors">FAQ</a>
          <a href="#" class="text-lg hover:text-olive transition-colors">Blog</a>
        </nav>
      </div>

      <div id="contact" class="scroll-mt-24">
        <div class="h-1 w-12 rounded-full bg-gold mb-3.5"></div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage mb-2">Contact</p>
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center gap-2">
            <Icon name="building-2" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed">Bella Technologies Private Limited</p>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="map-pin" class="w-4 h-4 text-olive shrink-0 mt-[6.5px]" />
            <p class="text-lg text-charcoal/65 leading-relaxed">3/4 First Floor, Royal Garden, Meyyanur Bypass Road, Alagapuram (P.O), Salem, Tamil Nadu, India. Pincode: 636004</p>
          </div>
          <a
            href="https://wa.me/916385738399"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 w-fit"
          >
            <svg viewBox="0 0 720 720" class="w-4 h-4 text-olive shrink-0" fill="currentColor">
              <path d="M360,0C161.18,0,0,161.18,0,360c0,65.41,17.45,126.75,47.94,179.61L0,720l187.02-44.21c51.34,28.18,110.28,44.21,172.98,44.21,198.82,0,360-161.18,360-360S558.82,0,360,0ZM360,655.52c-60.17,0-116.13-17.98-162.82-48.87l-110.49,28.14,30.99-105.61c-33.53-47.93-53.2-106.26-53.2-169.19,0-163.21,132.31-295.52,295.52-295.52s295.52,132.31,295.52,295.52-132.31,295.52-295.52,295.52Z"/>
              <path d="M444.35,407.52l87.1,41.06c4,1.88,6.56,5.94,6.2,10.34-.94,11.46-5.54,34.43-26.13,55.02-58.12,58.12-162.49-7.64-166.74-10.18-25.67-13.79-50.06-32.24-73.19-55.36-23.12-23.12-41.58-47.52-55.37-73.19-2.55-4.24-68.31-108.61-10.18-166.74,20.59-20.59,43.56-25.19,55.02-26.13,4.41-.36,8.46,2.2,10.34,6.2l41.07,87.1c1.94,4.12,1.09,9.02-2.13,12.24l-30.61,30.61c-6.62,6.62-8.56,16.93-4,25.11,11.17,20.03,26.19,39.32,43.59,57.07,17.75,17.4,37.04,32.43,57.07,43.59,8.18,4.56,18.48,2.62,25.11-4l30.61-30.61c3.22-3.22,8.12-4.08,12.24-2.13Z"/>
            </svg>
            <p class="text-lg text-charcoal/65 leading-relaxed group-hover:text-olive transition-colors">+91 63857 38399</p>
          </a>
          <a href="tel:+916385738399" class="group flex items-center gap-2 w-fit">
            <Icon name="phone" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed group-hover:text-olive transition-colors">+91 63857 38399</p>
          </a>
          <a href="mailto:contact@bellatechnologies.in" class="group flex items-center gap-2 w-fit">
            <Icon name="mail" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed group-hover:text-olive transition-colors">contact@bellatechnologies.in</p>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-3.5 border-t border-charcoal/10 text-center sm:text-left">
      <p class="text-charcoal/50 text-base">© 2026 Bella Technologies. All rights reserved.</p>
    </div>
  </div>
</footer>
