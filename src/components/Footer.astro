---
import Icon from './Icon.astro';
---
<footer class="bg-cream border-t border-charcoal/10 pt-16 sm:pt-24 pb-28 sm:pb-14">
  <div class="max-w-content mx-auto px-4 sm:px-6">
    <div class="grid sm:grid-cols-[1.4fr_1fr_1fr] gap-8 sm:gap-6">
      <div>
        <div class="h-1 w-12 rounded-full bg-olive mb-3.5"></div>
        <p class="font-jakarta text-xl font-bold">Bella Technologies</p>
        <p class="mt-3 text-charcoal/60 text-lg leading-relaxed max-w-xs">Helping spa and wellness businesses in Florida, USA turn more enquiries into bookings and keep clients coming back.</p>
      </div>

      <div>
        <div class="h-1 w-12 rounded-full bg-gold mb-3.5"></div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage mb-2">Menu</p>
        <nav class="flex flex-col gap-2">
          <a href="#" class="text-lg hover:text-olive transition-colors">Home</a>
          <a href="#how-it-works" class="text-lg hover:text-olive transition-colors">How It Works</a>
          <a href="#faq" class="text-lg hover:text-olive transition-colors">FAQ</a>
          <a href="#" class="text-lg hover:text-olive transition-colors">Blog</a>
        </nav>
      </div>

      <div>
        <div class="h-1 w-12 rounded-full bg-gold mb-3.5"></div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage mb-2">Registered Office</p>
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center gap-2">
            <Icon name="building-2" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed">Bella Technologies Private Limited</p>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="map-pin" class="w-4 h-4 text-olive shrink-0 mt-[6.5px]" />
            <p class="text-lg text-charcoal/65 leading-relaxed">3/4 First Floor, Royal Garden, Meyyanur Bypass Road, Alagapuram (P.O), Salem, Tamil Nadu, India. Pincode: 636004</p>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="phone" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed">+91 63857 38399</p>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="mail" class="w-4 h-4 text-olive shrink-0" />
            <p class="text-lg text-charcoal/65 leading-relaxed">contact@bellatechnologies.in</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-3.5 border-t border-charcoal/10 text-center sm:text-left">
      <p class="text-charcoal/50 text-base">© 2026 Bella Technologies. All rights reserved.</p>
    </div>
  </div>
</footer>
